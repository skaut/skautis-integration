{
  "name": "skautis-integration",
  "version": "1.1.31",
  "description": "A WordPress plugin for integration with SkautIS",
  "keywords": [
    "wordpress",
    "skaut",
    "skautis"
  ],
  "homepage": "https://wordpress.org/plugins/skautis-integration",
  "bugs": {
    "url": "https://github.com/skaut/skautis-integration/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaut/skautis-integration.git"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Marek Dědič",
    "email": "marek@dedic.eu",
    "url": "https://dedic.eu"
  },
  "contributors": [
    {
      "name": "David Odehnal",
      "email": "info@davidodehnal.cz"
    }
  ],
  "type": "module",
  "exports": {
    ".": null
  },
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "gulp build",
    "check": "run-p -c --aggregate-output check:*",
    "check:css-compat": "node scripts/check-css-compat.js",
    "clean": "rimraf dist/*",
    "lint": "run-p -c --aggregate-output lint:*",
    "lint:css": "run-p -c --aggregate-output lint:css:*",
    "lint:css:stylelint": "stylelint --color --report-needless-disables 'src/**/*.css'",
    "lint:eslint": "eslint --color",
    "lint:php": "run-p -c --aggregate-output lint:php:*",
    "lint:php:phan": "export PHAN_DISABLE_XDEBUG_WARN=1; vendor/bin/phan",
    "lint:php:phpcs": "vendor/bin/phpcs",
    "lint:php:phpmd": "vendor/bin/phpmd src,.phan/config.php,scoper.inc.php,phpstan-bootstrap.php text phpmd.xml",
    "lint:php:phpstan": "vendor/bin/phpstan",
    "lint:typecheck": "tsc --noEmit",
    "plugin-check": "wp-env start && wp-env run cli wp plugin check skautis-integration --ignore-codes=missing_composer_json_file; CODE=$?; wp-env stop; exit $CODE"
  },
  "browserslist": [
    "baseline 2019",
    "not edge 18"
  ],
  "dependencies": {
    "datatables.net": "^3.0.2",
    "datatables.net-dt": "^3.0.2",
    "datatables.net-plugins": "^3.0.2",
    "font-awesome": "^4.7.0",
    "interactjs": "^1.10.28",
    "jQuery-QueryBuilder": "^3.0.0",
    "jquery.repeater": "^1.2.1",
    "select2": "^4.1.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/jquery": "^4.0.1",
    "@types/jqueryui": "^1.12.24",
    "@types/select2": "^4.0.63",
    "@types/tinymce": "^4.6.9",
    "@wordpress/env": "^11.14.0",
    "@wordpress/eslint-plugin": "^25.9.0",
    "@wordpress/stylelint-config": "^24.2.0",
    "browserslist": "^4.28.8",
    "doiuse": "^6.0.6",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-package-json": "^1.7.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prefer-arrow-functions": "^3.4.2 <3.11",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "gulp": "^5.0.1",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-shell": "^0.8.0",
    "gulp-terser": "^2.1.0",
    "gulp-typescript": "^6.0.0-alpha.1",
    "lightningcss": "^1.33.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
